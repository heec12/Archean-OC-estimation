for phase in keys(modes)
    if phase ∉ ["T(K)", "P(bar)", "elements"]
        phase_grids[phase] = reshape(modes[phase], length(P_VEC), length(T_VEC))
    end
end

# ── Load H2O uncertainty from ensemble CSV ────────────────────────────────────
std_path  = "/Users/hchoi342/Documents/Archean-OC/h2o_lookup/h2o_bound_std_homogeneous_crust.csv"
mean_path = "/Users/hchoi342/Documents/Archean-OC/h2o_lookup/h2o_bound_mean_homogeneous_crust.csv"

# Read CR-only CSV
function read_cr_csv(path)
    raw  = read(path, String)
    rows = split(raw, '\r')
    header = split(rows[1], ',')[2:end]   # skip empty first cell
    data = zeros(Float64, length(rows)-1, length(header))
    p_vals = Float64[]
    for (i, row) in enumerate(rows[2:end])
        cells = split(row, ',')
        push!(p_vals, parse(Float64, cells[1]))
        for (j, c) in enumerate(cells[2:end])
            data[i, j] = isempty(c) ? NaN : parse(Float64, c)
        end
    end
    return p_vals, parse.(Float64, header), data
end

p_ens, t_ens, h2o_mean_ens = read_cr_csv(mean_path)
_,     _,     h2o_std_ens  = read_cr_csv(std_path)

# ── PLOT 1: Phase diagram coloured by dominant hydrous phase ──────────────────
# Build a colour map: each P-T cell coloured by the hydrous phase with most vol%
dominant = fill("", length(P_VEC), length(T_VEC))
for j in 1:length(T_VEC), i in 1:length(P_VEC)
    best_phase = ""
    best_vol   = 0.0
    for phase in hydrous
        if haskey(phase_grids, phase)
            v = phase_grids[phase][i, j]
            if !isnan(v) && v > best_vol
                best_vol   = v
                best_phase = phase
            end
        end
    end
    dominant[i, j] = best_phase
end

# Assign integer codes for plotting
all_phases = unique(filter(!isempty, vec(dominant)))
code = Dict(p => i for (i, p) in enumerate(all_phases))
push!(code, "" => 0)
dom_code = [code[dominant[i,j]] for i in 1:length(P_VEC), j in 1:length(T_VEC)]

p1 = heatmap(
    T_K .- 273.15, P_GPa, dom_code,
    c          = :tab10,
    xlabel     = "Temperature (°C)",
    ylabel     = "Pressure (GPa)",
    title      = "Dominant hydrous phase\n(homogeneous crust, sample 41)",
    colorbar   = false,
    yflip      = false,
    clims      = (0, length(all_phases)),
)
# Add phase name annotations
for (phase, idx) in code
    isempty(phase) && continue
    # find centroid of this phase field
    mask = dom_code .== idx
    if any(mask)
        ti = mean(findall(mask) .|> x -> x[2])
        pi = mean(findall(mask) .|> x -> x[1])
        annotate!(p1, T_K[round(Int,ti)] - 273.15, P_GPa[round(Int,pi)],
                  text(phase, 6, :white, :center))
    end
end

# ── PLOT 2: H2O content (wt%) from representative run ────────────────────────
p2 = heatmap(
    T_K .- 273.15, P_GPa, h2o_sys,
    c        = :blues,
    xlabel   = "Temperature (°C)",
    ylabel   = "Pressure (GPa)",
    title    = "Bound H₂O wt%\n(representative run, sample 41)",
    colorbar_title = "wt% H₂O",
)

# ── PLOT 3: H2O uncertainty (std) from ensemble ───────────────────────────────
p3 = heatmap(
    t_ens .- 273.15, p_ens, h2o_std_ens,
    c        = :heat,
    xlabel   = "Temperature (°C)",
    ylabel   = "Pressure (GPa)",
    title    = "H₂O uncertainty (1σ, wt%)\n(200-sample ensemble)",
    colorbar_title = "σ H₂O wt%",
)

# ── PLOT 4: H2O mean from ensemble with uncertainty contours ──────────────────
p4 = heatmap(
    t_ens .- 273.15, p_ens, h2o_mean_ens,
    c        = :blues,
    xlabel   = "Temperature (°C)",
    ylabel   = "Pressure (GPa)",
    title    = "Ensemble mean H₂O wt%\nwith 1σ uncertainty contours",
    colorbar_title = "wt% H₂O",
)
contour!(p4, t_ens .- 273.15, p_ens, h2o_std_ens,
    levels     = 5,
    color      = :white,
    linewidth  = 1,
    linestyle  = :dash,
    label      = "1σ",
)

# ── Combine and save ──────────────────────────────────────────────────────────
fig = plot(p1, p2, p3, p4,
    layout = (2, 2),
    size   = (1400, 1000),
    margin = 5Plots.mm,
)

savefig(fig, "/Users/hchoi342/Documents/Archean-OC/pseudosection_uncertainty.png")
println("Saved: pseudosection_uncertainty.png")

