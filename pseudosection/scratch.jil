using StatGeochem, CSV, DataFrames, Statistics, LinearAlgebra, Plots

# const P_VEC = collect(range(0.0001 * 10000, 8.0 * 10000, length=80))
# const T_VEC = collect(range(200.0, 1600.0, length=80))
const P_VEC = collect(range(0.0001 * 10000, 8.0 * 10000, length=40))  # bar
const T_VEC = collect(range(273.0, 1600.0, length=40))                 # Kelvin

scratchdir = "/tmp/perplex_ensemble/homogeneous_crust_sample_41"

# ── Convert to P-T grids ──────────────────────────────────────────────────────

# Build 2D grid manually — query each P slice at all T values
n_P = length(P_VEC)
n_T = length(T_VEC)

# Get phase names from a single point first
test = perplex_query_modes(scratchdir, [P_VEC[1]], [T_VEC[1]])
phase_names = [k for k in keys(test) if k ∉ ["T(K)", "P(bar)", "elements"]]
println("Phases found: ", phase_names)

# Storage
phase_grids = Dict(p => fill(NaN, n_P, n_T) for p in phase_names)
h2o_grid    = fill(NaN, n_P, n_T)
T_ax        = fill(NaN, n_P, n_T)
P_ax        = fill(NaN, n_P, n_T)

for (j, P) in enumerate(P_VEC)
    result = perplex_query_modes(scratchdir, fill(P, n_T), T_VEC)
    sys    = perplex_query_system(scratchdir, fill(P, n_T), T_VEC)  # renamed to sys
    for phase in phase_names
        if haskey(result, phase)
            phase_grids[phase][j, :] = result[phase]
        end
    end
    if haskey(sys, "H2O")
        h2o_grid = haskey(phase_grids, "H2O") ? phase_grids["H2O"] : fill(NaN, n_P, n_T)
    end
end

# Free fluid H2O (h2oL = liquid water, H2O = fluid)
free_fluid_grid = get(phase_grids, "h2oL", fill(0.0, n_P, n_T))

# Bound H2O — sum vol% of hydrous solid phases
hydrous_solids = ["Chl(W)", "law", "zo", "cz", "phA", "liz", "br"]
bound_h2o_grid = fill(0.0, n_P, n_T)
for phase in hydrous_solids
    if haskey(phase_grids, phase)
        v = phase_grids[phase]
        bound_h2o_grid .+= replace(v, NaN => 0.0)
    end
end

println("Free fluid range: ", minimum(free_fluid_grid), " to ", maximum(free_fluid_grid))
println("Bound H2O (sum vol%) range: ", minimum(bound_h2o_grid), " to ", maximum(bound_h2o_grid))

T_K   = T_VEC
P_GPa = P_VEC ./ 10000

# ── Hydrous phases — H2O content ─────────────────────────────────────────────
# Phases that carry water in your system
hydrous = ["Chl(W)", "Ep(HP)", "law", "zo", "cz", "phA", "liz", "br", "H2O"]

# Total bound H2O from system (wt%)
h2o_sys = reshape(system["H2O"], length(P_VEC), length(T_VEC))

# Individual phase modes (vol%)
